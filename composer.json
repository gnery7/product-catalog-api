{
    "name": "gnery7/product-catalog-api",
    "description": "API multi-empresa de catalogo de produtos, com categorias traduzidas, estoque e comentarios em Slim 4 + MySQL.",
    "require": {
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "robmorgan/phinx": "^0.16.6",
        "symfony/yaml": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts":{
        "migrate": "./vendor/bin/phinx migrate",
        "create-migration": "./vendor/bin/phinx create",
        "rollback": "./vendor/bin/phinx rollback",

        "test": ["phpunit --testsuite unit --testdox"],
        "lint": "./vendor/bin/phpcs --standard=PSR12 src",
        "lint-fix": "./vendor/bin/phpcbf --standard=PSR12 src",
        "stan": "./vendor/bin/phpstan analyse src --level=5",
        "seed": "./vendor/bin/phinx seed:run -s DatabaseSeeder",
        "seed-segunda-empresa": "./vendor/bin/phinx seed:run -s SegundaEmpresaSeeder"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^4.0.2",
        "phpstan/phpstan": "^2.2"
    }
}